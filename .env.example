MONGODB_URL=mongodb://dev:dev@127.0.0.1:27017/myapp?authSource=admin
# Optional backend overrides; src/main.ts defaults to 127.0.0.1:3000.
# HOST=127.0.0.1
# PORT=3000

# From your Clerk application's API Keys page. Never commit the real secret key.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Browser origins allowed in verified session tokens.
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:8080,http://localhost:8080

# Optional Gemini discovery (server only; authenticate with Application Default Credentials).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_MODEL=gemini-3-flash-preview
